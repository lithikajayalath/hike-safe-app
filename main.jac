import from "@jac/mobui" { View, Text, Pressable, TextInput, ScrollView, Image, useWindowDimensions }
import from .theme { LIGHT, buildStyles }
import from .ExploreMap { ExploreMap }


glob styles = buildStyles(LIGHT);
glob destinations: list[dict] = [
    {"id":"ella","name":"Ella Rock","district":"Badulla District","image":"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk":"Unknown risk · unverified","access":"Legal status unverified","camp":"Camping information unavailable","height":"Not verified","coords":"Not verified","distance":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","hazards":"No verified route hazards available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable","distance_km":0.0,"distance_known":False,"elevation_m":0,"elevation_known":False,"trail_km":0.0,"trail_distance_known":False,"time_minutes":0,"time_known":False,"rating":0.0,"rating_known":False,"latitude":0.0,"longitude":0.0,"coordinates_known":False,"weather_suitability":"Unavailable"},
    {"id":"knuckles","name":"Knuckles Range","district":"Matale District","image":"https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk":"Unknown risk · unverified","access":"Legal status unverified","camp":"Camping information unavailable","height":"Not verified","coords":"Not verified","distance":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","hazards":"No verified route hazards available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable","distance_km":0.0,"distance_known":False,"elevation_m":0,"elevation_known":False,"trail_km":0.0,"trail_distance_known":False,"time_minutes":0,"time_known":False,"rating":0.0,"rating_known":False,"latitude":0.0,"longitude":0.0,"coordinates_known":False,"weather_suitability":"Unavailable"},
    {"id":"pitu","name":"Pidurutalagala Foothills","district":"Nuwara Eliya District","image":"https://images.unsplash.com/photo-1472396961693-142e6e269027?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk":"Unknown risk · unverified","access":"Legal status unverified","camp":"Camping information unavailable","height":"Not verified","coords":"Not verified","distance":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","hazards":"No verified route hazards available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable","distance_km":0.0,"distance_known":False,"elevation_m":0,"elevation_known":False,"trail_km":0.0,"trail_distance_known":False,"time_minutes":0,"time_known":False,"rating":0.0,"rating_known":False,"latitude":0.0,"longitude":0.0,"coordinates_known":False,"weather_suitability":"Unavailable"},
    {"id":"hantana","name":"Hantana Ridge","district":"Kandy District","image":"https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk":"Unknown risk · unverified","access":"Legal status unverified","camp":"Camping information unavailable","height":"Not verified","coords":"Not verified","distance":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","hazards":"No verified route hazards available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable","distance_km":0.0,"distance_known":False,"elevation_m":0,"elevation_known":False,"trail_km":0.0,"trail_distance_known":False,"time_minutes":0,"time_known":False,"rating":0.0,"rating_known":False,"latitude":0.0,"longitude":0.0,"coordinates_known":False,"weather_suitability":"Unavailable"}
];
glob tabs: list[str] = ["Home", "Explore", "Start Hike", "Saved", "Profile"];
glob icons: list[str] = ["⌂", "⌕", "↗", "♡", "○"];

def DestinationCard(place: dict, saved: bool, distanceLabel: str, onSave: Callable[[str], None], onOpen: Callable[[str], None]) -> JsxElement {
    return <View style={styles.card}>
        <Pressable onPress={lambda { onOpen(place["id"]); }}><View style={styles.destImageWrap}><Image source={{"uri": place["image"]}} style={styles.destImage} resizeMode="cover"/></View><Text style={styles.destName}>{place["name"]}</Text><Text style={styles.destMeta}>{place["district"]} · {distanceLabel}</Text></Pressable>
        <View style={styles.spread}><View style={styles.riskUnknown}><Text style={styles.riskUnknownText}>{place["risk"]}</Text></View><Pressable style={styles.outlineButton} onPress={lambda { onSave(place["id"]); }}><Text style={styles.outlineText}>{"Saved" if saved else "Save"}</Text></Pressable></View>
        <View style={styles.chipRow}><View style={styles.chip}><Text style={styles.chipText}>Difficulty: {place["difficulty"]}</Text></View><View style={styles.chip}><Text style={styles.chipText}>{place["access"]}</Text></View></View>
        <View style={styles.chipRow}><View style={styles.chip}><Text style={styles.chipText}>{place["camp"]}</Text></View><View style={styles.chip}><Text style={styles.chipText}>Elevation: {place["height"]}</Text></View></View>
        <Text style={styles.tiny}>Weather: forecast unavailable</Text>
    </View>;
}

def DetailPage(place: dict, onBack: Callable[[], None]) -> JsxElement {
    return <View style={{"gap": 16}}>
        <Pressable style={styles.backButton} onPress={onBack}><Text style={styles.outlineText}>‹  Back to trails</Text></Pressable>
        <View style={styles.detailHero}><Image source={{"uri": place["image"]}} style={styles.detailPhoto} resizeMode="cover"/><View style={styles.heroShade}/><View style={styles.detailHeader}><Text style={styles.heroTitle}>{place["name"]}</Text><Text style={styles.heroSub}>{place["district"]}</Text></View></View>
        <View style={styles.riskUnknown}><Text style={styles.riskUnknownText}>{place["risk"]}</Text></View>
        <View style={styles.mapDetail}><Text style={styles.mapDetailText}>MAP PLACEHOLDER · Coordinates: {place["coords"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Overview</Text><Text style={styles.factLabel}>Height above sea level</Text><Text style={styles.factValue}>{place["height"]}</Text><Text style={styles.factLabel}>District</Text><Text style={styles.factValue}>{place["district"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Trail Information</Text><Text style={styles.factLabel}>Distance · elevation gain · estimated time</Text><Text style={styles.factValue}>{place["distance"]} · {place["gain"]} · {place["time"]}</Text><Text style={styles.factLabel}>Difficulty</Text><Text style={styles.factValue}>{place["difficulty"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Safety</Text><Text style={styles.body}>Risk classification is unverified; no safety rating is assigned.</Text><Text style={styles.factLabel}>Hazards</Text><Text style={styles.body}>{place["hazards"]}</Text><Text style={styles.factLabel}>Dangerous trail sections</Text><Text style={styles.body}>No verified hazard locations or descriptions available.</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Permissions</Text><Text style={styles.factLabel}>Legal access · permits · guide requirement</Text><Text style={styles.factValue}>{place["access"]} · {place["permit"]} · {place["guide"]}</Text><Text style={styles.factLabel}>Official permission contact</Text><Text style={styles.factValue}>{place["contact"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Camping</Text><Text style={styles.factLabel}>Availability</Text><Text style={styles.factValue}>{place["camp"]}</Text><Text style={styles.factLabel}>Location · price · facilities</Text><Text style={styles.factValue}>{place["camp_location"]} · {place["camp_price"]} · {place["camp_facilities"]}</Text><Text style={styles.factLabel}>Booking contact · restrictions</Text><Text style={styles.factValue}>{place["camp_contact"]} · {place["camp_restrictions"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Facilities</Text><Text style={styles.factValue}>Facilities: {place["facilities"]}</Text><Text style={styles.factValue}>Water sources: {place["water"]}</Text><Text style={styles.factValue}>Parking: {place["parking"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Mountain weather</Text><Text style={styles.riskUnknownText}>Insufficient weather data</Text><Text style={styles.factValue}>No verified mountain coordinates. No forecast requested.</Text><Text style={styles.tiny}>Temperature, rainfall, wind, hourly/daily outlook and hiking warnings are unavailable until a weather provider is configured. This is not a safety assessment.</Text><Text style={styles.factValue}>Open Hiking weather from Home for provider setup information.</Text></View>
        <View style={styles.notice}><Text style={styles.noticeText}>Development sample. Details are unverified. Confirm with official local sources before visiting.</Text></View>
    </View>;
}

def:pub app -> JsxElement {
    has activeTab: str = "Home", query: str = "", savedIds: list[str] = [], detailId: str = "", selectedWeather: str = "All", pendingWeather: str = "All", exploreMode: str = "List", gpsLat: str = "", gpsLon: str = "", gpsDistanceMessage: str = "", selectedRisk: str = "All", selectedAccess: str = "All", selectedCamp: str = "All", selectedDifficulty: str = "All", selectedDistance: str = "All", sortMode: str = "Default", pendingRisk: str = "All", pendingAccess: str = "All", pendingCamp: str = "All", pendingDifficulty: str = "All", pendingDistance: str = "All", startLocation: str = "Browse all locations", startingRadius: int = 50;
    viewport = useWindowDimensions();
    filteredPlaces = [p for p in destinations if (not query or query.lower() in p["name"].lower() or query.lower() in p["district"].lower() or query.lower() in p["difficulty"].lower() or query.lower() in p["camp"].lower()) and (selectedRisk == "All" or p["risk_key"] == selectedRisk) and (selectedAccess == "All" or p["access_key"] == selectedAccess) and (selectedCamp == "All" or p["camp_key"] == selectedCamp) and (selectedDifficulty == "All" or p["difficulty"] == selectedDifficulty) and (selectedDistance == "All" or (p["distance_known"] and selectedDistance != "Nearest" and (p["distance_km"] as float) <= startingRadius) or (selectedDistance == "Nearest" and p["coordinates_known"] and startLocation != "Browse all locations")) and (selectedWeather == "All" or p["weather_suitability"] == selectedWeather)];
    rankedPlaces = filteredPlaces;
    if sortMode == "Safest" { rankedPlaces = [p for p in destinations if p in filteredPlaces and p["risk_key"] == "Low"] + [p for p in destinations if p in filteredPlaces and p["risk_key"] == "Moderate"] + [p for p in destinations if p in filteredPlaces and p["risk_key"] == "High"] + [p for p in destinations if p in filteredPlaces and p["risk_key"] == "Unknown"]; }
    elif sortMode == "Nearest" and startLocation != "Browse all locations" { rankedPlaces = [p for p in filteredPlaces if p["coordinates_known"]]; }
    elif sortMode == "Shortest" { rankedPlaces = [p for p in filteredPlaces if p["trail_distance_known"]]; }
    elif sortMode == "Highest" { rankedPlaces = [p for p in filteredPlaces if p["elevation_known"]]; }
    elif sortMode == "Time" { rankedPlaces = [p for p in filteredPlaces if p["time_known"]]; }
    elif sortMode == "Rating" { rankedPlaces = [p for p in filteredPlaces if p["rating_known"]]; }
    savedPlaces = [p for p in destinations if p["id"] in savedIds];
    selectedPlace = {};
    for p in destinations { if p["id"] == detailId { selectedPlace = p; } }
    cards = [<DestinationCard key={p["id"]} place={p} saved={p["id"] in savedIds} distanceLabel={p["distance"] if p["distance_known"] else "Distance unavailable"} onSave={lambda (id: str) { savedIds = [v for v in savedIds if v != id] if id in savedIds else savedIds + [id]; }} onOpen={lambda (id: str) { detailId = id; }}/> for p in rankedPlaces];
    savedCards = [<DestinationCard key={p["id"]} place={p} saved={True} distanceLabel={p["distance"] if p["distance_known"] else "Distance unavailable"} onSave={lambda (id: str) { savedIds = [v for v in savedIds if v != id]; }} onOpen={lambda (id: str) { detailId = id; }}/> for p in savedPlaces];
    def selectTab(name: str) { activeTab = name; detailId = ""; query = ""; }
    def selectMap { exploreMode = "Map"; }
    def selectList { exploreMode = "List"; }
    def acceptGps(lat: str, lon: str) { gpsLat = lat; gpsLon = lon; gpsDistanceMessage = "GPS location received; distances require verified trail coordinates."; }
    def selectRisk(value: str) { pendingRisk = value if pendingRisk != value else "All"; }
    def selectAccess(value: str) { pendingAccess = value if pendingAccess != value else "All"; }
    def selectCamp(value: str) { pendingCamp = value if pendingCamp != value else "All"; }
    def selectDifficulty(value: str) { pendingDifficulty = value if pendingDifficulty != value else "All"; }
    def selectDistance(value: str) { pendingDistance = value if pendingDistance != value else "All"; }
    def applyFilters {
        selectedRisk = pendingRisk;
        selectedAccess = pendingAccess;
        selectedCamp = pendingCamp;
        selectedDifficulty = pendingDifficulty;
        selectedDistance = pendingDistance;
        selectedWeather = pendingWeather;
    }
    def clearFilters {
        selectedRisk = "All"; selectedAccess = "All"; selectedCamp = "All"; selectedDifficulty = "All"; selectedDistance = "All"; selectedWeather = "All";
        pendingRisk = "All"; pendingAccess = "All"; pendingCamp = "All"; pendingDifficulty = "All"; pendingDistance = "All"; pendingWeather = "All"; query = "";
    }
    def resetSort { sortMode = "Default"; }
    def chooseSort(value: str) { sortMode = value; }
    def isChoice(group: str, value: str) -> bool {
        if group == "risk" { return pendingRisk == value; }
        elif group == "access" { return pendingAccess == value; }
        elif group == "camp" { return pendingCamp == value; }
        elif group == "difficulty" { return pendingDifficulty == value; }
        else { return pendingDistance == value; }
    }
    def setChoice(group: str, value: str) {
        if group == "risk" { selectRisk(value); }
        elif group == "access" { selectAccess(value); }
        elif group == "camp" { selectCamp(value); }
        elif group == "difficulty" { selectDifficulty(value); }
        else { selectDistance(value); }
    }

    return <View style={[styles.screen, {"height": viewport.height}]}>
        <ScrollView style={styles.screen} contentContainerStyle={styles.scrollContent} showsVerticalScrollIndicator={False}>
            {if activeTab == "Weather" {
                <View style={{"gap": 16}}><Pressable style={styles.backButton} onPress={lambda { selectTab("Home"); }}><Text style={styles.outlineText}>‹  Back</Text></Pressable><Text style={styles.eyebrow}>SRI LANKA WEATHER</Text><Text style={styles.title}>Hiking weather</Text><Text style={styles.subtitle}>Forecasts require verified destination coordinates and a configured provider.</Text><View style={styles.notice}><Text style={styles.noticeText}>Weather provider is not configured. Add an OpenWeather API key in Settings → Environment. No live weather is shown.</Text></View><View style={styles.card}><Text style={styles.sectionTitle}>Current conditions</Text><Text style={styles.factValue}>Unavailable · location permission not granted</Text><Text style={styles.tiny}>Temperature, precipitation, wind, humidity, cloud, visibility, warnings, sunrise, and sunset unavailable.</Text><Text style={styles.factLabel}>Last updated</Text><Text style={styles.factValue}>No forecast retrieved</Text></View><View style={styles.card}><Text style={styles.sectionTitle}>Sri Lanka destinations</Text><Text style={styles.subtitle}>Select a mountain; its forecast requires its own verified coordinates.</Text>{[<Pressable key={p["id"]} style={styles.outlineButton} onPress={lambda { detailId = p["id"]; selectTab("Home"); }}><Text style={styles.outlineText}>{p["name"]} · {p["district"]} · forecast unavailable</Text></Pressable> for p in destinations]}</View><View style={styles.card}><Text style={styles.sectionTitle}>Forecast outlook</Text><Text style={styles.factValue}>Hourly 24-hour forecast: unavailable</Text><Text style={styles.factValue}>Daily forecast: unavailable</Text><Text style={styles.riskUnknownText}>Insufficient weather data</Text><Text style={styles.tiny}>Elevation adjustment is not configured. Weather alone cannot establish hike safety.</Text></View></View>;
            }
            elif detailId != "" {
                <DetailPage place={selectedPlace} onBack={lambda { detailId = ""; }}/>
            }
            elif activeTab == "Home" {
                <View style={{"gap": 20}}><View style={styles.header}><View style={styles.brandline}><View style={styles.brandMark}><Text style={styles.brandGlyph}>H</Text></View><Text style={styles.brand}>HikeSafe</Text></View><View style={styles.locationIcon}><Text style={styles.locationPin}>⌖</Text></View></View>
                <View style={{"gap": 7}}><Text style={styles.eyebrow}>YOUR NEXT OUTDOOR DAY</Text><Text style={styles.title}>Find your trail.</Text><Text style={styles.subtitle}>A little closer to the wild, one step at a time.</Text></View>
                <View style={styles.search}><Text style={styles.searchGlyph}>⌕</Text><TextInput style={styles.searchInput} value={query} placeholder="Search mountains and trails" placeholderTextColor={LIGHT["muted"]} onChangeText={lambda (t: str) { query = t; }}/></View>
                <View style={styles.hero}><Image source={{"uri":"https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1200&q=85"}} style={styles.heroImage} resizeMode="cover"/><View style={styles.heroShade}/><View style={styles.heroContent}><Text style={styles.heroTitle}>Take the scenic route.</Text><Text style={styles.heroSub}>Explore Sri Lanka's highland trails</Text></View></View>
                <Text style={styles.sectionTitle}>Nearby trail ideas</Text>{cards}
                <Pressable style={styles.weather} onPress={lambda { activeTab = "Weather"; detailId = ""; }}><Text style={styles.weatherIcon}>☼</Text><View style={styles.weatherInfo}><Text style={styles.weatherTemp}>Hiking weather</Text><Text style={styles.subtitle}>Forecast unavailable · open weather dashboard</Text></View></Pressable>
                <Text style={styles.sectionTitle}>Saved for later</Text>{savedCards}<Pressable style={styles.button} onPress={lambda { selectTab("Start Hike"); }}><Text style={styles.buttonText}>Start planning a hike</Text></Pressable>
                <View style={styles.notice}><Text style={styles.noticeText}>Development sample data only. Risk, access, hazards, and camping details are unverified.</Text></View></View>;
            }
            elif activeTab == "Explore" {
                <View style={{"gap": 13}}><View style={styles.header}><Text style={styles.brand}>HikeSafe</Text><Text style={styles.locationPin}>⌖</Text></View><Text style={styles.eyebrow}>DISCOVER SRI LANKA</Text><Text style={styles.title}>Explore trails</Text><Text style={styles.subtitle}>Combine filters to browse sample destinations.</Text>
                <View style={styles.row}><Pressable style={styles.outlineButton} onPress={lambda { selectList(); }}><Text style={styles.outlineText}>List</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectMap(); }}><Text style={styles.outlineText}>Map</Text></Pressable></View>
                <View style={styles.search}><Text style={styles.searchGlyph}>⌕</Text><TextInput style={styles.searchInput} value={query} placeholder="Search mountains and trails" placeholderTextColor={LIGHT["muted"]} onChangeText={lambda (t: str) { query = t; }}/></View>
                <View style={styles.card}><Text style={styles.filterLabel}>STARTING LOCATION</Text><Text style={styles.body}>{startLocation}</Text><View style={styles.row}><Pressable style={styles.outlineButton} onPress={lambda { startLocation = "Kandy (manual selection)"; }}><Text style={styles.outlineText}>Set Kandy</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { startLocation = "Browse all locations"; selectedDistance = "All"; pendingDistance = "All"; if sortMode == "Nearest" { sortMode = "Default"; } }}><Text style={styles.outlineText}>Browse all</Text></Pressable></View><Text style={styles.tiny}>GPS is not connected. Nearest/radius filtering needs verified coordinates; manual Kandy is a label only.</Text></View>
                <View style={styles.card}><Text style={styles.sectionTitle}>Filters</Text>
                    <Text style={styles.filterLabel}>DISTANCE</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { selectDistance("Nearest"); }}><Text style={styles.outlineText}>Nearest</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDistance("5"); startingRadius = 5; }}><Text style={styles.outlineText}>5 km</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDistance("10"); startingRadius = 10; }}><Text style={styles.outlineText}>10 km</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDistance("25"); startingRadius = 25; }}><Text style={styles.outlineText}>25 km</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDistance("50"); startingRadius = 50; }}><Text style={styles.outlineText}>50 km</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDistance("All"); }}><Text style={styles.outlineText}>All distances</Text></Pressable></View>
                    <Text style={styles.filterLabel}>RISK</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { selectRisk("Low"); }}><Text style={styles.outlineText}>Low</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectRisk("Moderate"); }}><Text style={styles.outlineText}>Moderate</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectRisk("High"); }}><Text style={styles.outlineText}>High</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectRisk("Unknown"); }}><Text style={styles.outlineText}>Unknown</Text></Pressable></View>
                    <Text style={styles.filterLabel}>LEGAL ACCESS</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { selectAccess("Public"); }}><Text style={styles.outlineText}>Public</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectAccess("Permit"); }}><Text style={styles.outlineText}>Permit</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectAccess("Private"); }}><Text style={styles.outlineText}>Private</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectAccess("Restricted"); }}><Text style={styles.outlineText}>Restricted</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectAccess("Closed"); }}><Text style={styles.outlineText}>Closed</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectAccess("Unverified"); }}><Text style={styles.outlineText}>Unverified</Text></Pressable></View>
                    <Text style={styles.filterLabel}>CAMPING</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { selectCamp("Public"); }}><Text style={styles.outlineText}>Public</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectCamp("Private"); }}><Text style={styles.outlineText}>Private</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectCamp("Both"); }}><Text style={styles.outlineText}>Both</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectCamp("Permission"); }}><Text style={styles.outlineText}>Permission</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectCamp("Prohibited"); }}><Text style={styles.outlineText}>Prohibited</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectCamp("Unavailable"); }}><Text style={styles.outlineText}>Unknown</Text></Pressable></View>
                    <Text style={styles.filterLabel}>DIFFICULTY</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { selectDifficulty("Easy"); }}><Text style={styles.outlineText}>Easy</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDifficulty("Moderate"); }}><Text style={styles.outlineText}>Moderate</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDifficulty("Difficult"); }}><Text style={styles.outlineText}>Difficult</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDifficulty("Expert"); }}><Text style={styles.outlineText}>Expert</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDifficulty("Unknown"); }}><Text style={styles.outlineText}>Unknown</Text></Pressable></View>
                    <Text style={styles.filterLabel}>WEATHER SUITABILITY</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { pendingWeather = "Favorable"; }}><Text style={styles.outlineText}>Favorable</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { pendingWeather = "Caution"; }}><Text style={styles.outlineText}>Caution</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { pendingWeather = "Dangerous"; }}><Text style={styles.outlineText}>Potentially dangerous</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { pendingWeather = "Unavailable"; }}><Text style={styles.outlineText}>Forecast unavailable</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { pendingWeather = "All"; }}><Text style={styles.outlineText}>Any</Text></Pressable></View>
                    <View style={styles.row}><Pressable style={styles.button} onPress={lambda { applyFilters(); }}><Text style={styles.buttonText}>Apply filters</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { clearFilters(); }}><Text style={styles.outlineText}>Clear all</Text></Pressable></View>
                    <Text style={styles.tiny}>Straight-line distances require real GPS and verified destination coordinates. Walking/driving routes are not calculated.</Text>
                </View>
                <View style={styles.card}><Text style={styles.filterLabel}>SORT RESULTS</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { chooseSort("Safest"); }}><Text style={styles.outlineText}>Lowest listed risk</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { chooseSort("Nearest"); }}><Text style={styles.outlineText}>Nearest</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { chooseSort("Shortest"); }}><Text style={styles.outlineText}>Shortest hike</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { chooseSort("Highest"); }}><Text style={styles.outlineText}>Highest elevation</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { chooseSort("Time"); }}><Text style={styles.outlineText}>Shortest time</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { chooseSort("Rating"); }}><Text style={styles.outlineText}>Highest rating</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { resetSort(); }}><Text style={styles.outlineText}>Reset sorting</Text></Pressable></View><Text style={styles.tiny}>Risk order is Low, Moderate, High, Unknown and is not a safety guarantee. Ratings, GPS coordinates, distances, elevation, and hiking times are unavailable in these samples.</Text></View>
                {if exploreMode == "Map" { <ExploreMap onMyLocation={acceptGps}/> }}
                <Text style={styles.sectionTitle}>{str(len(filteredPlaces))} matching destinations</Text>
                {if len(filteredPlaces) == 0 {
                    <View style={styles.emptyState}><Text style={styles.sectionTitle}>No destinations match</Text><Text style={styles.subtitle}>No sample has verified values for those filters. Unknown values do not count as confirmed matches.</Text></View>
                    skip;
                }}
                {cards}
                <View style={styles.notice}><Text style={styles.noticeText}>Development samples only. Risk, access, hazards, camping, and trail facts are unverified.</Text></View></View>;
            }
            elif activeTab == "Saved" { <View style={{"gap": 18}}><Text style={styles.title}>Saved trails</Text>{savedCards}</View>; }
            elif activeTab == "Start Hike" { <View style={{"gap": 18}}><Text style={styles.title}>Plan a safe hike.</Text><View style={styles.card}><Text style={styles.body}>Check current access and weather locally. Tell someone your route and return time. Carry water and suitable footwear.</Text></View><Pressable style={styles.button} onPress={lambda { selectTab("Explore"); }}><Text style={styles.buttonText}>Choose a trail</Text></Pressable></View>; }
            else { <View style={{"gap": 18}}><Text style={styles.title}>Profile</Text><View style={styles.card}><Text style={styles.body}>Hiker preferences and personal details will appear here.</Text></View></View>; }}
        </ScrollView>
        {if detailId == "" { <View style={styles.tabs}>{for (i, tab) in enumerate(tabs) { <Pressable key={tab} style={styles.tab} onPress={lambda { selectTab(tab); }}><Text style={styles.tabIcon}>{icons[i]}</Text><Text style={styles.tabActive if activeTab == tab else styles.tabInactive}>{tab}</Text></Pressable> }}</View> }}
    </View>;
}

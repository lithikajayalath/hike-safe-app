import from "@jac/mobui" { View, Text, Pressable, TextInput, ScrollView, Image, useWindowDimensions }
import from .theme { LIGHT, buildStyles }
import from .ExploreMap { ExploreMap }
import from .HikeTracker { HikeTracker }


glob styles = buildStyles(LIGHT);
glob destinations: list[dict] = [
    {"id":"ella","name":"Ella Rock","district":"Badulla District","image":"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk":"Unknown risk · unverified","access":"Legal status unverified","camp":"Camping information unavailable","height":"Not verified","coords":"Not verified","distance":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","hazards":"Unverified sample field. No location-specific hazard reports are available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable","distance_km":0.0,"distance_known":False,"elevation_m":0,"elevation_known":False,"trail_km":0.0,"trail_distance_known":False,"time_minutes":0,"time_known":False,"rating":0.0,"rating_known":False,"latitude":0.0,"longitude":0.0,"coordinates_known":False,"weather_suitability":"Unavailable","description":"Not verified","data_source":"No verified source recorded · development sample","last_verified":"Not verified","guide_status":"Unknown","legal_access_status":"Unverified","permit_requirements":"Not verified","public_camping_status":"Unknown","private_camping_status":"Unknown","verified_hazards":[],"historical_accidents":[],"accident_source":"No verified accident records or source recorded"},
    {"id":"knuckles","name":"Knuckles Range","district":"Matale District","image":"https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk":"Unknown risk · unverified","access":"Legal status unverified","camp":"Camping information unavailable","height":"Not verified","coords":"Not verified","distance":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","hazards":"Unverified sample field. No location-specific hazard reports are available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable","distance_km":0.0,"distance_known":False,"elevation_m":0,"elevation_known":False,"trail_km":0.0,"trail_distance_known":False,"time_minutes":0,"time_known":False,"rating":0.0,"rating_known":False,"latitude":0.0,"longitude":0.0,"coordinates_known":False,"weather_suitability":"Unavailable","description":"Not verified","data_source":"No verified source recorded · development sample","last_verified":"Not verified","guide_status":"Unknown","legal_access_status":"Unverified","permit_requirements":"Not verified","public_camping_status":"Unknown","private_camping_status":"Unknown","verified_hazards":[],"historical_accidents":[],"accident_source":"No verified accident records or source recorded"},
    {"id":"pitu","name":"Pidurutalagala Foothills","district":"Nuwara Eliya District","image":"https://images.unsplash.com/photo-1472396961693-142e6e269027?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk":"Unknown risk · unverified","access":"Legal status unverified","camp":"Camping information unavailable","height":"Not verified","coords":"Not verified","distance":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","hazards":"Unverified sample field. No location-specific hazard reports are available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable","distance_km":0.0,"distance_known":False,"elevation_m":0,"elevation_known":False,"trail_km":0.0,"trail_distance_known":False,"time_minutes":0,"time_known":False,"rating":0.0,"rating_known":False,"latitude":0.0,"longitude":0.0,"coordinates_known":False,"weather_suitability":"Unavailable","description":"Not verified","data_source":"No verified source recorded · development sample","last_verified":"Not verified","guide_status":"Unknown","legal_access_status":"Unverified","permit_requirements":"Not verified","public_camping_status":"Unknown","private_camping_status":"Unknown","verified_hazards":[],"historical_accidents":[],"accident_source":"No verified accident records or source recorded"},
    {"id":"hantana","name":"Hantana Ridge","district":"Kandy District","image":"https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk":"Unknown risk · unverified","access":"Legal status unverified","camp":"Camping information unavailable","height":"Not verified","coords":"Not verified","distance":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","hazards":"Unverified sample field. No location-specific hazard reports are available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable","distance_km":0.0,"distance_known":False,"elevation_m":0,"elevation_known":False,"trail_km":0.0,"trail_distance_known":False,"time_minutes":0,"time_known":False,"rating":0.0,"rating_known":False,"latitude":0.0,"longitude":0.0,"coordinates_known":False,"weather_suitability":"Unavailable","description":"Not verified","data_source":"No verified source recorded · development sample","last_verified":"Not verified","guide_status":"Unknown","legal_access_status":"Unverified","permit_requirements":"Not verified","public_camping_status":"Unknown","private_camping_status":"Unknown","verified_hazards":[],"historical_accidents":[],"accident_source":"No verified accident records or source recorded"}
];
glob tabs: list[str] = ["Home", "Explore", "Start Hike", "Saved", "Profile"];
glob icons: list[str] = ["⌂", "⌕", "↗", "♡", "○"];

def DestinationCard(place: dict, saved: bool, distanceLabel: str, onSave: Callable[[str], None], onOpen: Callable[[str], None]) -> JsxElement {
    return <View style={styles.card}>
        <Pressable onPress={lambda { onOpen(place["id"]); }}><View style={styles.destImageWrap}><Image source={{"uri": place["image"]}} style={styles.destImage} resizeMode="cover"/></View><Text style={styles.destName}>{place["name"]}</Text><Text style={styles.destMeta}>{place["district"]} · {distanceLabel}</Text></Pressable>
        <View style={styles.spread}><View style={styles.riskUnknown}><Text style={styles.riskUnknownText}>{place["risk"]}</Text></View><Pressable style={styles.outlineButton} onPress={lambda { onSave(place["id"]); }}><Text style={styles.outlineText}>{"Saved" if saved else "Save"}</Text></Pressable></View>
        <View style={styles.chipRow}><View style={styles.chip}><Text style={styles.chipText}>Difficulty: {place["difficulty"]}</Text></View><View style={styles.chip}><Text style={styles.chipText}>{place["access"]}</Text></View></View>
        <View style={styles.chipRow}><View style={styles.chip}><Text style={styles.chipText}>{place["camp"]}</Text></View><View style={styles.chip}><Text style={styles.chipText}>Elevation: {place["height"]}</Text></View></View>
        <Text style={styles.tiny}>Weather: forecast unavailable</Text>
    </View>;
}

def DetailPage(place: dict, onBack: Callable[[], None]) -> JsxElement {
    has reviews: list[dict] = [],
        rating: int = 0, perceivedRisk: str = "Moderate", climbingTime: str = "",
        reviewDifficulty: str = "", trailConditions: str = "", experience: str = "", incidentNote: str = "",
        reviewStatus: str = "";
    def submitReview {
        if rating < 1 or rating > 5 or not reviewDifficulty.strip() or not trailConditions.strip() or not experience.strip() {
            reviewStatus = "Please choose a star rating and complete difficulty, trail conditions, and experience.";
            return;
        }
        nowText = str(new(Date).toISOString());
        review = {"rid": nowText + str(len(reviews)), "mountain_id": place["id"], "date": nowText[:10], "rating": rating, "risk": perceivedRisk, "climbing_time": climbingTime.strip() if climbingTime.strip() else "Not provided", "difficulty": reviewDifficulty.strip(), "conditions": trailConditions.strip(), "experience": experience.strip(), "incident": incidentNote.strip()};
        reviews = reviews + [review];
        rating = 0; climbingTime = ""; reviewDifficulty = ""; trailConditions = ""; experience = ""; incidentNote = "";
        reviewStatus = "Review added for this mountain in this session. It is a community report, not verified.";
    }
    return <View style={{"gap": 16}}>
        <Pressable style={styles.backButton} onPress={onBack}><Text style={styles.outlineText}>‹  Back to trails</Text></Pressable>
        <View style={styles.detailHero}><Image source={{"uri": place["image"]}} style={styles.detailPhoto} resizeMode="cover"/><View style={styles.heroShade}/><View style={styles.detailHeader}><Text style={styles.heroTitle}>{place["name"]}</Text><Text style={styles.heroSub}>{place["district"]}</Text></View></View>
        <View style={styles.riskUnknown}><Text style={styles.riskUnknownText}>{place["risk"]}</Text></View>
        <View style={styles.mapDetail}><Text style={styles.mapDetailText}>MAP PLACEHOLDER · Coordinates: {place["coords"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Overview</Text><Text style={styles.factLabel}>Description</Text><Text style={styles.factValue}>{place["description"]}</Text><Text style={styles.factLabel}>Height above sea level</Text><Text style={styles.factValue}>{place["height"]}</Text><Text style={styles.factLabel}>District</Text><Text style={styles.factValue}>{place["district"]}</Text><Text style={styles.factLabel}>Data source · last verified</Text><Text style={styles.factValue}>{place["data_source"]} · {place["last_verified"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Trail Information</Text><Text style={styles.factLabel}>Distance · elevation gain · estimated time</Text><Text style={styles.factValue}>{place["distance"]} · {place["gain"]} · {place["time"]}</Text><Text style={styles.factLabel}>Difficulty</Text><Text style={styles.factValue}>{place["difficulty"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Safety</Text><Text style={styles.body}>Risk classification is unverified; no safety rating is assigned.</Text><Text style={styles.factLabel}>Risk source · last verified</Text><Text style={styles.factValue}>{place["data_source"]} · {place["last_verified"]}</Text><Text style={styles.factLabel}>Hazards</Text><Text style={styles.body}>{place["hazards"]}</Text><Text style={styles.factLabel}>Dangerous trail sections</Text><Text style={styles.body}>No verified hazard locations or descriptions available.</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Terrain &amp; Hazards</Text><Text style={styles.factLabel}>Verified hazard markers</Text><Text style={styles.body}>No verified hazard reports. Coordinates are not available.</Text><Text style={styles.factLabel}>Hazard categories</Text><Text style={styles.body}>Cliffs, slippery rocks, exposed ridges, river crossings and landslides: no verified reports on file.</Text><Text style={styles.factLabel}>Official accident records</Text><Text style={styles.body}>No verified records supplied. {place["accident_source"]}</Text><Text style={styles.factLabel}>Mountain height · elevation gain</Text><Text style={styles.factValue}>{place["height"]} · {place["gain"]}</Text><Text style={styles.factLabel}>Trail elevation profile</Text><Text style={styles.body}>Unavailable; no verified route geometry or elevation samples.</Text><Text style={styles.factLabel}>Data source · last verified</Text><Text style={styles.factValue}>{place["data_source"]} · {place["last_verified"]}</Text><View style={styles.mapDetail}><Text style={styles.mapDetailText}>Map tiles are not configured. No 3D terrain view is available.</Text></View></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Permissions</Text><Text style={styles.factLabel}>Legal access · permit requirements · guide</Text><Text style={styles.factValue}>{place["legal_access_status"]} · {place["permit_requirements"]} · {place["guide_status"]}</Text><Text style={styles.factLabel}>Official permission contact</Text><Text style={styles.factValue}>{place["contact"]}</Text><Text style={styles.factLabel}>Source · verification</Text><Text style={styles.factValue}>{place["data_source"]} · {place["last_verified"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Camping</Text><Text style={styles.factLabel}>Availability</Text><Text style={styles.factValue}>Public: {place["public_camping_status"]} · Private: {place["private_camping_status"]}</Text><Text style={styles.factLabel}>Location · price · facilities</Text><Text style={styles.factValue}>{place["camp_location"]} · {place["camp_price"]} · {place["camp_facilities"]}</Text><Text style={styles.factLabel}>Booking contact · restrictions</Text><Text style={styles.factValue}>{place["camp_contact"]} · {place["camp_restrictions"]}</Text><Text style={styles.factLabel}>Source · verification</Text><Text style={styles.factValue}>{place["data_source"]} · {place["last_verified"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Facilities</Text><Text style={styles.factValue}>Facilities: {place["facilities"]}</Text><Text style={styles.factValue}>Water sources: {place["water"]}</Text><Text style={styles.factValue}>Parking: {place["parking"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Reviews &amp; Experiences</Text><Text style={styles.tiny}>Session-only community reports. They are not verified reviews or official accident records; no user identity or persistent shared storage is configured.</Text>
            {if len(reviews) == 0 { <View style={styles.emptyState}><Text style={styles.body}>No reviews for this mountain yet.</Text></View> } else { for r in reviews { if r["mountain_id"] == place["id"] { <View key={r["rid"]} style={styles.card}><Text style={styles.factValue}>{str(r["rating"])} / 5 stars · {r["date"]}</Text><Text style={styles.factLabel}>Perceived risk: {r["risk"]} · Difficulty: {r["difficulty"]}</Text><Text style={styles.body}>Climbing time: {r["climbing_time"]}</Text><Text style={styles.body}>Trail conditions: {r["conditions"]}</Text><Text style={styles.body}>{r["experience"]}</Text><Text style={styles.tiny}>Community-reported incidents, not verified accident records: {r["incident"] if r["incident"] else "None reported"}</Text></View> } } }}
            <Text style={styles.sectionTitle}>Add a review</Text>
            <Text style={styles.filterLabel}>OVERALL RATING (REQUIRED)</Text>
            <View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { rating = 1; }}><Text style={styles.outlineText}>1 star</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { rating = 2; }}><Text style={styles.outlineText}>2 stars</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { rating = 3; }}><Text style={styles.outlineText}>3 stars</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { rating = 4; }}><Text style={styles.outlineText}>4 stars</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { rating = 5; }}><Text style={styles.outlineText}>5 stars</Text></Pressable></View>
            <Text style={styles.filterLabel}>YOUR PERCEIVED RISK</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { perceivedRisk = "Low"; }}><Text style={styles.outlineText}>Low</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { perceivedRisk = "Moderate"; }}><Text style={styles.outlineText}>Moderate</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { perceivedRisk = "High"; }}><Text style={styles.outlineText}>High</Text></Pressable></View>
            <TextInput style={styles.searchInput} value={climbingTime} placeholder="Actual climbing time (optional)" placeholderTextColor={LIGHT["muted"]} onChangeText={lambda (v: str) { climbingTime = v; }}/>
            <TextInput style={styles.searchInput} value={reviewDifficulty} placeholder="Hiking difficulty (required)" placeholderTextColor={LIGHT["muted"]} onChangeText={lambda (v: str) { reviewDifficulty = v; }}/>
            <TextInput style={styles.searchInput} value={trailConditions} placeholder="Trail conditions (required)" placeholderTextColor={LIGHT["muted"]} onChangeText={lambda (v: str) { trailConditions = v; }}/>
            <TextInput style={styles.searchInput} value={experience} placeholder="Your experience (required)" placeholderTextColor={LIGHT["muted"]} multiline={True} onChangeText={lambda (v: str) { experience = v; }}/>
            <TextInput style={styles.searchInput} value={incidentNote} placeholder="Injuries or accidents experienced/witnessed (optional, unverified)" placeholderTextColor={LIGHT["muted"]} multiline={True} onChangeText={lambda (v: str) { incidentNote = v; }}/>
            <Text style={styles.tiny}>Incident notes are community-reported and must not be treated as confirmed accident history.</Text>
            <Pressable style={styles.button} onPress={lambda { submitReview(); }}><Text style={styles.buttonText}>Submit review</Text></Pressable>
            <Text style={styles.tiny}>{reviewStatus if reviewStatus else "Reviews are stored only in this detail screen session; no photo upload or shared persistence is available."}</Text>
        </View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Mountain weather</Text><Text style={styles.riskUnknownText}>Insufficient weather data</Text><Text style={styles.factValue}>No verified mountain coordinates. No forecast requested.</Text><Text style={styles.tiny}>Temperature, rainfall, wind, hourly/daily outlook and hiking warnings are unavailable until a weather provider is configured. This is not a safety assessment.</Text><Text style={styles.factValue}>Open Hiking weather from Home for provider setup information.</Text></View>
        <View style={styles.notice}><Text style={styles.noticeText}>Development sample. Details are unverified. Confirm with official local sources before visiting.</Text></View>
    </View>;
}

def:pub app -> JsxElement {
    has activeTab: str = "Home", query: str = "", savedIds: list[str] = [], detailId: str = "", emergencyContactName: str = "", emergencyContactPhone: str = "", profileName: str = "", profileEmail: str = "", editingProfile: bool = False, measurementUnit: str = "Metric", selectedWeather: str = "All", pendingWeather: str = "All", exploreMode: str = "List", gpsLat: str = "", gpsLon: str = "", gpsDistanceMessage: str = "", selectedRisk: str = "All", selectedAccess: str = "All", selectedCamp: str = "All", selectedDifficulty: str = "All", selectedDistance: str = "All", sortMode: str = "Default", pendingRisk: str = "All", pendingAccess: str = "All", pendingCamp: str = "All", pendingDifficulty: str = "All", pendingDistance: str = "All", startLocation: str = "Browse all locations", startingRadius: int = 50;
    viewport = useWindowDimensions();
    filteredPlaces = [p for p in destinations if (not query or query.lower() in p["name"].lower() or query.lower() in p["district"].lower() or query.lower() in p["difficulty"].lower() or query.lower() in p["camp"].lower()) and (selectedRisk == "All" or p["risk_key"] == selectedRisk) and (selectedAccess == "All" or p["access_key"] == selectedAccess) and (selectedCamp == "All" or p["camp_key"] == selectedCamp) and (selectedDifficulty == "All" or p["difficulty"] == selectedDifficulty) and (selectedDistance == "All" or (p["distance_known"] and selectedDistance != "Nearest" and (p["distance_km"] as float) <= startingRadius) or (selectedDistance == "Nearest" and p["coordinates_known"] and startLocation != "Browse all locations")) and (selectedWeather == "All" or p["weather_suitability"] == selectedWeather)];
    def rankPlaces(items: list[dict]) -> list[dict] {
        if sortMode == "Safest" {
            return [p for p in destinations if p in items and p["risk_key"] == "Low"] + [p for p in destinations if p in items and p["risk_key"] == "Moderate"] + [p for p in destinations if p in items and p["risk_key"] == "High"] + [p for p in destinations if p in items and p["risk_key"] == "Unknown"];
        }
        elif sortMode == "Nearest" and startLocation != "Browse all locations" { return [p for p in items if p["coordinates_known"]]; }
        elif sortMode == "Shortest" { return [p for p in items if p["trail_distance_known"]]; }
        elif sortMode == "Highest" { return [p for p in items if p["elevation_known"]]; }
        elif sortMode == "Time" { return [p for p in items if p["time_known"]]; }
        elif sortMode == "Rating" { return [p for p in items if p["rating_known"]]; }
        return items;
    }
    rankedPlaces = rankPlaces(filteredPlaces);
    savedPlaces = [p for p in destinations if p["id"] in savedIds];
    selectedPlace = {};
    for p in destinations { if p["id"] == detailId { selectedPlace = p; } }
    cards = [<DestinationCard key={p["id"]} place={p} saved={p["id"] in savedIds} distanceLabel={p["distance"] if p["distance_known"] else "Distance unavailable"} onSave={lambda (id: str) { savedIds = [v for v in savedIds if v != id] if id in savedIds else savedIds + [id]; }} onOpen={lambda (id: str) { detailId = id; }}/> for p in rankedPlaces];
    savedCards = [<DestinationCard key={p["id"]} place={p} saved={True} distanceLabel={p["distance"] if p["distance_known"] else "Distance unavailable"} onSave={lambda (id: str) { savedIds = [v for v in savedIds if v != id]; }} onOpen={lambda (id: str) { detailId = id; }}/> for p in savedPlaces];
    def selectTab(name: str) { activeTab = name; detailId = ""; query = ""; }
    def selectMap { exploreMode = "Map"; }
    def selectList { exploreMode = "List"; }
    def acceptGps(lat: str, lon: str) { gpsLat = lat; gpsLon = lon; gpsDistanceMessage = "GPS location received; distances require verified trail coordinates."; }
    def selectRisk(value: str) { pendingRisk = value if pendingRisk != value else "All"; }
    def selectAccess(value: str) { pendingAccess = value if pendingAccess != value else "All"; }
    def selectCamp(value: str) { pendingCamp = value if pendingCamp != value else "All"; }
    def selectDifficulty(value: str) { pendingDifficulty = value if pendingDifficulty != value else "All"; }
    def selectDistance(value: str) { pendingDistance = value if pendingDistance != value else "All"; }
    def applyFilters {
        selectedRisk = pendingRisk;
        selectedAccess = pendingAccess;
        selectedCamp = pendingCamp;
        selectedDifficulty = pendingDifficulty;
        selectedDistance = pendingDistance;
        selectedWeather = pendingWeather;
    }
    def clearFilters {
        selectedRisk = "All"; selectedAccess = "All"; selectedCamp = "All"; selectedDifficulty = "All"; selectedDistance = "All"; selectedWeather = "All";
        pendingRisk = "All"; pendingAccess = "All"; pendingCamp = "All"; pendingDifficulty = "All"; pendingDistance = "All"; pendingWeather = "All"; query = "";
    }
    def resetSort { sortMode = "Default"; }
    def chooseSort(value: str) { sortMode = value; }
    def isChoice(group: str, value: str) -> bool {
        if group == "risk" { return pendingRisk == value; }
        elif group == "access" { return pendingAccess == value; }
        elif group == "camp" { return pendingCamp == value; }
        elif group == "difficulty" { return pendingDifficulty == value; }
        else { return pendingDistance == value; }
    }
    def setChoice(group: str, value: str) {
        if group == "risk" { selectRisk(value); }
        elif group == "access" { selectAccess(value); }
        elif group == "camp" { selectCamp(value); }
        elif group == "difficulty" { selectDifficulty(value); }
        else { selectDistance(value); }
    }

    return <View style={[styles.screen, {"height": viewport.height}]}>
        <ScrollView style={styles.screen} contentContainerStyle={styles.scrollContent} showsVerticalScrollIndicator={False}>
            {if activeTab == "Weather" {
                <View style={{"gap": 16}}><Pressable style={styles.backButton} onPress={lambda { selectTab("Home"); }}><Text style={styles.outlineText}>‹  Back</Text></Pressable><Text style={styles.eyebrow}>SRI LANKA WEATHER</Text><Text style={styles.title}>Hiking weather</Text><Text style={styles.subtitle}>Live forecasts require verified destination coordinates.</Text><View style={styles.notice}><Text style={styles.noticeText}>Open-Meteo can provide forecasts without an API key, but destination coordinates are not verified yet. No weather request has been made and no live weather is shown.</Text></View><View style={styles.card}><Text style={styles.sectionTitle}>Current conditions</Text><Text style={styles.factValue}>Unavailable · location permission not granted</Text><Text style={styles.tiny}>Temperature, precipitation, wind, humidity, cloud, visibility, warnings, sunrise, and sunset unavailable.</Text><Text style={styles.factLabel}>Last updated</Text><Text style={styles.factValue}>No forecast retrieved</Text></View><View style={styles.card}><Text style={styles.sectionTitle}>Sri Lanka destinations</Text><Text style={styles.subtitle}>Choose a destination to see its current details. Forecasts remain unavailable until its coordinates are verified.</Text>{[<Pressable key={p["id"]} style={styles.outlineButton} onPress={lambda { detailId = p["id"]; selectTab("Home"); }}><Text style={styles.outlineText}>{p["name"]} · {p["district"]} · forecast unavailable</Text></Pressable> for p in destinations]}</View><View style={styles.card}><Text style={styles.sectionTitle}>Forecast outlook</Text><Text style={styles.factValue}>Hourly 24-hour forecast: unavailable</Text><Text style={styles.factValue}>Daily forecast: unavailable</Text><Text style={styles.riskUnknownText}>Insufficient weather data</Text><Text style={styles.tiny}>Elevation adjustment is not configured. Weather alone cannot establish hike safety.</Text></View></View>;
            }
            elif detailId != "" {
                <DetailPage place={selectedPlace} onBack={lambda { detailId = ""; }}/>
            }
            elif activeTab == "Home" {
                <View style={{"gap": 20}}><View style={styles.header}><View style={styles.brandline}><View style={styles.brandMark}><Text style={styles.brandGlyph}>H</Text></View><Text style={styles.brand}>HikeSafe</Text></View><View style={styles.locationIcon}><Text style={styles.locationPin}>⌖</Text></View></View>
                <View style={{"gap": 7}}><Text style={styles.eyebrow}>YOUR NEXT OUTDOOR DAY</Text><Text style={styles.title}>Find your trail.</Text><Text style={styles.subtitle}>A little closer to the wild, one step at a time.</Text></View>
                <View style={styles.search}><Text style={styles.searchGlyph}>⌕</Text><TextInput style={styles.searchInput} value={query} placeholder="Search mountains and trails" placeholderTextColor={LIGHT["muted"]} onChangeText={lambda (t: str) { query = t; }}/></View>
                <View style={styles.hero}><Image source={{"uri":"https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1200&q=85"}} style={styles.heroImage} resizeMode="cover"/><View style={styles.heroShade}/><View style={styles.heroContent}><Text style={styles.heroTitle}>Take the scenic route.</Text><Text style={styles.heroSub}>Explore Sri Lanka's highland trails</Text></View></View>
                <Text style={styles.sectionTitle}>Nearby trail ideas</Text>{cards}
                <Pressable style={styles.weather} onPress={lambda { activeTab = "Weather"; detailId = ""; }}><Text style={styles.weatherIcon}>☼</Text><View style={styles.weatherInfo}><Text style={styles.weatherTemp}>Hiking weather</Text><Text style={styles.subtitle}>Forecast unavailable · open weather dashboard</Text></View></Pressable>
                <Text style={styles.sectionTitle}>Saved for later</Text>{savedCards}<Pressable style={styles.button} onPress={lambda { selectTab("Start Hike"); }}><Text style={styles.buttonText}>Start planning a hike</Text></Pressable>
                <View style={styles.notice}><Text style={styles.noticeText}>Development sample data only. Risk, access, hazards, and camping details are unverified.</Text></View></View>;
            }
            elif activeTab == "Explore" {
                <View style={{"gap": 13}}><View style={styles.header}><Text style={styles.brand}>HikeSafe</Text><Text style={styles.locationPin}>⌖</Text></View><Text style={styles.eyebrow}>DISCOVER SRI LANKA</Text><Text style={styles.title}>Explore trails</Text><Text style={styles.subtitle}>Combine filters to browse sample destinations.</Text>
                <View style={styles.row}><Pressable style={styles.outlineButton} onPress={lambda { selectList(); }}><Text style={styles.outlineText}>List</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectMap(); }}><Text style={styles.outlineText}>Map</Text></Pressable></View>
                <View style={styles.search}><Text style={styles.searchGlyph}>⌕</Text><TextInput style={styles.searchInput} value={query} placeholder="Search mountains and trails" placeholderTextColor={LIGHT["muted"]} onChangeText={lambda (t: str) { query = t; }}/></View>
                <View style={styles.card}><Text style={styles.filterLabel}>STARTING LOCATION</Text><Text style={styles.body}>{startLocation}</Text><View style={styles.row}><Pressable style={styles.outlineButton} onPress={lambda { startLocation = "Kandy (manual selection)"; }}><Text style={styles.outlineText}>Set Kandy</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { startLocation = "Browse all locations"; selectedDistance = "All"; pendingDistance = "All"; if sortMode == "Nearest" { sortMode = "Default"; } }}><Text style={styles.outlineText}>Browse all</Text></Pressable></View><Text style={styles.tiny}>GPS is not connected. Nearest/radius filtering needs verified coordinates; manual Kandy is a label only.</Text></View>
                <View style={styles.card}><Text style={styles.sectionTitle}>Filters</Text>
                    <Text style={styles.filterLabel}>DISTANCE</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { selectDistance("Nearest"); }}><Text style={styles.outlineText}>Nearest</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDistance("5"); startingRadius = 5; }}><Text style={styles.outlineText}>5 km</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDistance("10"); startingRadius = 10; }}><Text style={styles.outlineText}>10 km</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDistance("25"); startingRadius = 25; }}><Text style={styles.outlineText}>25 km</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDistance("50"); startingRadius = 50; }}><Text style={styles.outlineText}>50 km</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDistance("All"); }}><Text style={styles.outlineText}>All distances</Text></Pressable></View>
                    <Text style={styles.filterLabel}>RISK</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { selectRisk("Low"); }}><Text style={styles.outlineText}>Low</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectRisk("Moderate"); }}><Text style={styles.outlineText}>Moderate</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectRisk("High"); }}><Text style={styles.outlineText}>High</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectRisk("Unknown"); }}><Text style={styles.outlineText}>Unknown</Text></Pressable></View>
                    <Text style={styles.filterLabel}>LEGAL ACCESS</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { selectAccess("Public"); }}><Text style={styles.outlineText}>Public</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectAccess("Permit"); }}><Text style={styles.outlineText}>Permit</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectAccess("Private"); }}><Text style={styles.outlineText}>Private</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectAccess("Restricted"); }}><Text style={styles.outlineText}>Restricted</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectAccess("Closed"); }}><Text style={styles.outlineText}>Closed</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectAccess("Unverified"); }}><Text style={styles.outlineText}>Unverified</Text></Pressable></View>
                    <Text style={styles.filterLabel}>CAMPING</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { selectCamp("Public"); }}><Text style={styles.outlineText}>Public</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectCamp("Private"); }}><Text style={styles.outlineText}>Private</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectCamp("Both"); }}><Text style={styles.outlineText}>Both</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectCamp("Permission"); }}><Text style={styles.outlineText}>Permission</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectCamp("Prohibited"); }}><Text style={styles.outlineText}>Prohibited</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectCamp("Unavailable"); }}><Text style={styles.outlineText}>Unknown</Text></Pressable></View>
                    <Text style={styles.filterLabel}>DIFFICULTY</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { selectDifficulty("Easy"); }}><Text style={styles.outlineText}>Easy</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDifficulty("Moderate"); }}><Text style={styles.outlineText}>Moderate</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDifficulty("Difficult"); }}><Text style={styles.outlineText}>Difficult</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDifficulty("Expert"); }}><Text style={styles.outlineText}>Expert</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { selectDifficulty("Unknown"); }}><Text style={styles.outlineText}>Unknown</Text></Pressable></View>
                    <Text style={styles.filterLabel}>WEATHER SUITABILITY</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { pendingWeather = "Favorable"; }}><Text style={styles.outlineText}>Favorable</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { pendingWeather = "Caution"; }}><Text style={styles.outlineText}>Caution</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { pendingWeather = "Dangerous"; }}><Text style={styles.outlineText}>Potentially dangerous</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { pendingWeather = "Unavailable"; }}><Text style={styles.outlineText}>Forecast unavailable</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { pendingWeather = "All"; }}><Text style={styles.outlineText}>Any</Text></Pressable></View>
                    <View style={styles.row}><Pressable style={styles.button} onPress={lambda { applyFilters(); }}><Text style={styles.buttonText}>Apply filters</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { clearFilters(); }}><Text style={styles.outlineText}>Clear all</Text></Pressable></View>
                    <Text style={styles.tiny}>Straight-line distances require real GPS and verified destination coordinates. Walking/driving routes are not calculated.</Text>
                </View>
                <View style={styles.card}><Text style={styles.filterLabel}>SORT RESULTS</Text><View style={styles.chipRow}><Pressable style={styles.outlineButton} onPress={lambda { chooseSort("Safest"); }}><Text style={styles.outlineText}>Lowest listed risk</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { chooseSort("Nearest"); }}><Text style={styles.outlineText}>Nearest</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { chooseSort("Shortest"); }}><Text style={styles.outlineText}>Shortest hike</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { chooseSort("Highest"); }}><Text style={styles.outlineText}>Highest elevation</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { chooseSort("Time"); }}><Text style={styles.outlineText}>Shortest time</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { chooseSort("Rating"); }}><Text style={styles.outlineText}>Highest rating</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { resetSort(); }}><Text style={styles.outlineText}>Reset sorting</Text></Pressable></View><Text style={styles.tiny}>Risk order is Low, Moderate, High, Unknown and is not a safety guarantee. Ratings, GPS coordinates, distances, elevation, and hiking times are unavailable in these samples.</Text></View>
                {if exploreMode == "Map" { <ExploreMap onMyLocation={acceptGps}/> }}
                <Text style={styles.sectionTitle}>{str(len(filteredPlaces))} matching destinations</Text>
                {if len(filteredPlaces) == 0 {
                    <View style={styles.emptyState}><Text style={styles.sectionTitle}>No destinations match</Text><Text style={styles.subtitle}>No sample has verified values for those filters. Unknown values do not count as confirmed matches.</Text></View>
                    skip;
                }}
                {cards}
                <View style={styles.notice}><Text style={styles.noticeText}>Development samples only. Risk, access, hazards, camping, and trail facts are unverified.</Text></View></View>;
            }
            elif activeTab == "Saved" { <View style={{"gap": 18}}><Text style={styles.title}>Saved trails</Text><Text style={styles.subtitle}>Your saved destinations are available in this app session.</Text>{if len(savedCards) == 0 { <View style={styles.emptyState}><Text style={styles.sectionTitle}>No saved destinations</Text><Text style={styles.body}>Bookmark a trail from Home or Explore to keep it here.</Text></View> }}{savedCards}<Pressable style={styles.outlineButton} onPress={lambda { if window.confirm("Remove all saved destinations? This will not clear other profile or contact information.") { savedIds = []; } }}><Text style={styles.outlineText}>Clear saved destinations</Text></Pressable></View>; }
            elif activeTab == "Start Hike" { <HikeTracker contactName={emergencyContactName} contactPhone={emergencyContactPhone} onSaveContact={lambda (n: str, p: str) { emergencyContactName = n; emergencyContactPhone = p; }}/>; }
            else { <View style={{"gap": 18}}><Text style={styles.title}>Profile</Text><Text style={styles.subtitle}>Your hiking profile and personal preferences.</Text><View style={styles.card}><Text style={styles.sectionTitle}>Hiker profile</Text>{if editingProfile { <View style={{"gap": 10}}><TextInput style={styles.searchInput} value={profileName} placeholder="Your name" placeholderTextColor={LIGHT["muted"]} onChangeText={lambda (v: str) { profileName = v; }}/><TextInput style={styles.searchInput} value={profileEmail} placeholder="Email (optional)" placeholderTextColor={LIGHT["muted"]} onChangeText={lambda (v: str) { profileEmail = v; }}/><Pressable style={styles.button} onPress={lambda { editingProfile = False; }}><Text style={styles.buttonText}>Save profile</Text></Pressable></View> } else { <View style={{"gap": 8}}><Text style={styles.factValue}>{profileName if profileName else "Hiker"}</Text><Text style={styles.body}>{profileEmail if profileEmail else "Add an email address if desired."}</Text><Pressable style={styles.outlineButton} onPress={lambda { editingProfile = True; }}><Text style={styles.outlineText}>Edit profile</Text></Pressable></View> }}</View><View style={styles.card}><Text style={styles.sectionTitle}>Hiking statistics</Text><Text style={styles.factValue}>Completed hikes: unavailable</Text><Text style={styles.factValue}>Total distance: unavailable</Text><Text style={styles.factValue}>Total duration: unavailable</Text><Text style={styles.factValue}>Elevation gain: unavailable</Text><Text style={styles.tiny}>No completed hike history is stored yet. The tracker only holds an active session.</Text><Pressable style={styles.outlineButton} onPress={lambda { selectTab("Start Hike"); }}><Text style={styles.outlineText}>Open hiking tracker</Text></Pressable></View><View style={styles.card}><Text style={styles.sectionTitle}>Measurement units</Text><View style={styles.row}><Pressable style={styles.outlineButton} onPress={lambda { measurementUnit = "Metric"; }}><Text style={styles.outlineText}>{"Metric · km / m" if measurementUnit == "Metric" else "Use km / m"}</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { measurementUnit = "Imperial"; }}><Text style={styles.outlineText}>{"Imperial · mi / ft" if measurementUnit == "Imperial" else "Use mi / ft"}</Text></Pressable></View><Text style={styles.tiny}>Preference applies to this session; sample destination facts remain unverified.</Text></View><View style={styles.card}><Text style={styles.sectionTitle}>Saved destinations</Text><Text style={styles.body}>{str(len(savedIds))} saved destinations</Text><Pressable style={styles.outlineButton} onPress={lambda { selectTab("Saved"); }}><Text style={styles.outlineText}>View saved trails</Text></Pressable></View><View style={styles.card}><Text style={styles.sectionTitle}>Privacy &amp; safety settings</Text><Text style={styles.body}>Location sharing is off; no live location is shared.</Text><Text style={styles.factLabel}>Emergency contact</Text><Text style={styles.factValue}>{emergencyContactName if emergencyContactName else "No contact saved"} · {emergencyContactPhone if emergencyContactPhone else "Phone number unavailable"}</Text><Text style={styles.tiny}>Contact details are kept in this app session and are not shown publicly.</Text><Pressable style={styles.outlineButton} onPress={lambda { selectTab("Start Hike"); }}><Text style={styles.outlineText}>Manage emergency contact and location</Text></Pressable><Text style={styles.factLabel}>Health permissions</Text><Text style={styles.body}>No health data integration or permissions are configured.</Text></View><View style={styles.card}><Text style={styles.sectionTitle}>Reviews &amp; hiking history</Text><Text style={styles.body}>Mountain reviews are session-only on each destination. Completed hike history is unavailable.</Text><Text style={styles.tiny}>Reviews are community-submitted and are not official safety information.</Text><Pressable style={styles.outlineButton} onPress={lambda { savedPlaces = destinations; activeTab = "Explore"; }}><Text style={styles.outlineText}>Open destinations and reviews</Text></Pressable></View></View>; }}
        </ScrollView>
        {if detailId == "" { <View style={styles.tabs}>{for (i, tab) in enumerate(tabs) { <Pressable key={tab} style={styles.tab} onPress={lambda { selectTab(tab); }}><Text style={styles.tabIcon}>{icons[i]}</Text><Text style={styles.tabActive if activeTab == tab else styles.tabInactive}>{tab}</Text></Pressable> }}</View> }}
    </View>;
}

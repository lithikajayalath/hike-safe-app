import from "@jac/mobui" { View, Text, Pressable, TextInput, ScrollView, Image, useWindowDimensions }
import from .theme { LIGHT, buildStyles }

glob styles = buildStyles(LIGHT);
glob destinations: list[dict] = [
    {"id":"ella","name":"Ella Rock","district":"Badulla District","image":"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk":"Unknown risk · unverified","access":"Legal status unverified","camp":"Camping information unavailable","height":"Not verified","coords":"Not verified","distance":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","hazards":"No verified route hazards available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable"},
    {"id":"knuckles","name":"Knuckles Range","district":"Matale District","image":"https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk":"Unknown risk · unverified","access":"Legal status unverified","camp":"Camping information unavailable","height":"Not verified","coords":"Not verified","distance":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","hazards":"No verified route hazards available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable"},
    {"id":"pitu","name":"Pidurutalagala Foothills","district":"Nuwara Eliya District","image":"https://images.unsplash.com/photo-1472396961693-142e6e269027?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk":"Unknown risk · unverified","access":"Legal status unverified","camp":"Camping information unavailable","height":"Not verified","coords":"Not verified","distance":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","hazards":"No verified route hazards available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable"},
    {"id":"hantana","name":"Hantana Ridge","district":"Kandy District","image":"https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk":"Unknown risk · unverified","access":"Legal status unverified","camp":"Camping information unavailable","height":"Not verified","coords":"Not verified","distance":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","hazards":"No verified route hazards available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable"}
];
glob tabs: list[str] = ["Home", "Explore", "Start Hike", "Saved", "Profile"];
glob icons: list[str] = ["⌂", "⌕", "↗", "♡", "○"];

def DestinationCard(place: dict, saved: bool, onSave: Callable[[str], None], onOpen: Callable[[str], None]) -> JsxElement {
    return <View style={styles.card}>
        <Pressable onPress={lambda { onOpen(place["id"]); }}><View style={styles.destImageWrap}><Image source={{"uri": place["image"]}} style={styles.destImage} resizeMode="cover"/></View><Text style={styles.destName}>{place["name"]}</Text><Text style={styles.destMeta}>{place["district"]} · Distance {place["distance"]}</Text></Pressable>
        <View style={styles.spread}><View style={styles.riskUnknown}><Text style={styles.riskUnknownText}>{place["risk"]}</Text></View><Pressable style={styles.outlineButton} onPress={lambda { onSave(place["id"]); }}><Text style={styles.outlineText}>{"Saved" if saved else "Save"}</Text></Pressable></View>
        <View style={styles.chipRow}><View style={styles.chip}><Text style={styles.chipText}>Difficulty: {place["difficulty"]}</Text></View><View style={styles.chip}><Text style={styles.chipText}>{place["access"]}</Text></View></View><Text style={styles.tiny}>{place["camp"]}</Text>
    </View>;
}

def DetailPage(place: dict, onBack: Callable[[], None]) -> JsxElement {
    return <View style={{"gap": 16}}>
        <Pressable style={styles.backButton} onPress={onBack}><Text style={styles.outlineText}>‹  Back to trails</Text></Pressable>
        <View style={styles.detailHero}><Image source={{"uri": place["image"]}} style={styles.detailPhoto} resizeMode="cover"/><View style={styles.heroShade}/><View style={styles.detailHeader}><Text style={styles.heroTitle}>{place["name"]}</Text><Text style={styles.heroSub}>{place["district"]}</Text></View></View>
        <View style={styles.riskUnknown}><Text style={styles.riskUnknownText}>{place["risk"]}</Text></View>
        <View style={styles.mapDetail}><Text style={styles.mapDetailText}>MAP PLACEHOLDER · Coordinates: {place["coords"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Overview</Text><Text style={styles.factLabel}>Height above sea level</Text><Text style={styles.factValue}>{place["height"]}</Text><Text style={styles.factLabel}>District</Text><Text style={styles.factValue}>{place["district"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Trail Information</Text><Text style={styles.factLabel}>Distance · elevation gain · estimated time</Text><Text style={styles.factValue}>{place["distance"]} · {place["gain"]} · {place["time"]}</Text><Text style={styles.factLabel}>Difficulty</Text><Text style={styles.factValue}>{place["difficulty"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Safety</Text><Text style={styles.body}>Risk classification is unverified; no safety rating is assigned.</Text><Text style={styles.factLabel}>Hazards</Text><Text style={styles.body}>{place["hazards"]}</Text><Text style={styles.factLabel}>Dangerous trail sections</Text><Text style={styles.body}>No verified hazard locations or descriptions available.</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Permissions</Text><Text style={styles.factLabel}>Legal access · permits · guide requirement</Text><Text style={styles.factValue}>{place["access"]} · {place["permit"]} · {place["guide"]}</Text><Text style={styles.factLabel}>Official permission contact</Text><Text style={styles.factValue}>{place["contact"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Camping</Text><Text style={styles.factLabel}>Availability</Text><Text style={styles.factValue}>{place["camp"]}</Text><Text style={styles.factLabel}>Location · price · facilities</Text><Text style={styles.factValue}>{place["camp_location"]} · {place["camp_price"]} · {place["camp_facilities"]}</Text><Text style={styles.factLabel}>Booking contact · restrictions</Text><Text style={styles.factValue}>{place["camp_contact"]} · {place["camp_restrictions"]}</Text></View>
        <View style={styles.card}><Text style={styles.sectionTitle}>Facilities</Text><Text style={styles.factValue}>Facilities: {place["facilities"]}</Text><Text style={styles.factValue}>Water sources: {place["water"]}</Text><Text style={styles.factValue}>Parking: {place["parking"]}</Text></View>
        <View style={styles.notice}><Text style={styles.noticeText}>Development sample. Details are unverified. Confirm with official local sources before visiting.</Text></View>
    </View>;
}

def:pub app -> JsxElement {
    has activeTab: str = "Home", query: str = "", savedIds: list[str] = [], detailId: str = "", selectedRisk: str = "All", selectedAccess: str = "All", selectedCamp: str = "All", selectedDifficulty: str = "All", sortMode: str = "Default", startLocation: str = "Browse all locations";
    viewport = useWindowDimensions();
    results = [p for p in destinations if (not query or query.lower() in p["name"].lower() or query.lower() in p["district"].lower()) and (selectedRisk == "All" or p["risk_key"] == selectedRisk) and (selectedAccess == "All" or p["access_key"] == selectedAccess) and (selectedCamp == "All" or p["camp_key"] == selectedCamp) and (selectedDifficulty == "All" or p["difficulty"] == selectedDifficulty)];
    savedPlaces = [p for p in destinations if p["id"] in savedIds];
    selectedPlace = {};
    for p in destinations { if p["id"] == detailId { selectedPlace = p; } }
    cards = [<DestinationCard key={p["id"]} place={p} saved={p["id"] in savedIds} onSave={lambda (id: str) { savedIds = [v for v in savedIds if v != id] if id in savedIds else savedIds + [id]; }} onOpen={lambda (id: str) { detailId = id; }}/> for p in results];
    savedCards = [<DestinationCard key={p["id"]} place={p} saved={True} onSave={lambda (id: str) { savedIds = [v for v in savedIds if v != id]; }} onOpen={lambda (id: str) { detailId = id; }}/> for p in savedPlaces];
    def selectTab(name: str) { activeTab = name; detailId = ""; query = ""; }
    def setChoice(group: str, value: str) {
        if group == "risk" { selectedRisk = value if selectedRisk != value else "All"; }
        elif group == "access" { selectedAccess = value if selectedAccess != value else "All"; }
        elif group == "camp" { selectedCamp = value if selectedCamp != value else "All"; }
        elif group == "difficulty" { selectedDifficulty = value if selectedDifficulty != value else "All"; }
        else { sortMode = value; }
    }

    return <View style={[styles.screen, {"height": viewport.height}]}>
        <ScrollView style={styles.screen} contentContainerStyle={styles.scrollContent} showsVerticalScrollIndicator={False}>
            {if detailId != "" { <DetailPage place={selectedPlace} onBack={lambda { detailId = ""; }}/> }
            elif activeTab == "Home" {
                <View style={{"gap": 20}}><View style={styles.header}><View style={styles.brandline}><View style={styles.brandMark}><Text style={styles.brandGlyph}>H</Text></View><Text style={styles.brand}>HikeSafe</Text></View><View style={styles.locationIcon}><Text style={styles.locationPin}>⌖</Text></View></View>
                <View style={{"gap": 7}}><Text style={styles.eyebrow}>YOUR NEXT OUTDOOR DAY</Text><Text style={styles.title}>Find your trail.</Text><Text style={styles.subtitle}>A little closer to the wild, one step at a time.</Text></View>
                <View style={styles.search}><Text style={styles.searchGlyph}>⌕</Text><TextInput style={styles.searchInput} value={query} placeholder="Search mountains and trails" placeholderTextColor={LIGHT["muted"]} onChangeText={lambda (t: str) { query = t; }}/></View>
                <View style={styles.hero}><Image source={{"uri":"https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1200&q=85"}} style={styles.heroImage} resizeMode="cover"/><View style={styles.heroShade}/><View style={styles.heroContent}><Text style={styles.heroTitle}>Take the scenic route.</Text><Text style={styles.heroSub}>Explore Sri Lanka's highland trails</Text></View></View>
                <Text style={styles.sectionTitle}>Nearby trail ideas</Text>{cards}
                <View style={styles.weather}><Text style={styles.weatherIcon}>☼</Text><View style={styles.weatherInfo}><Text style={styles.weatherTemp}>Weather snapshot</Text><Text style={styles.subtitle}>Local forecast placeholder</Text></View></View>
                <Text style={styles.sectionTitle}>Saved for later</Text>{savedCards}<Pressable style={styles.button} onPress={lambda { selectTab("Start Hike"); }}><Text style={styles.buttonText}>Start planning a hike</Text></Pressable>
                <View style={styles.notice}><Text style={styles.noticeText}>Development sample data only. Risk, access, hazards, and camping details are unverified.</Text></View></View>;
            }
            elif activeTab == "Explore" {
                <View style={{"gap": 13}}><View style={styles.header}><Text style={styles.brand}>HikeSafe</Text><Text style={styles.locationPin}>⌖</Text></View><Text style={styles.eyebrow}>DISCOVER SRI LANKA</Text><Text style={styles.title}>Explore trails</Text><Text style={styles.subtitle}>Combine filters to browse sample destinations.</Text>
                <View style={styles.search}><Text style={styles.searchGlyph}>⌕</Text><TextInput style={styles.searchInput} value={query} placeholder="Search mountains and trails" placeholderTextColor={LIGHT["muted"]} onChangeText={lambda (t: str) { query = t; }}/></View>
                <View style={styles.card}><Text style={styles.filterLabel}>STARTING LOCATION</Text><Text style={styles.body}>{startLocation}</Text><View style={styles.row}><Pressable style={styles.outlineButton} onPress={lambda { startLocation = "Kandy (manual selection)"; }}><Text style={styles.outlineText}>Set Kandy</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { startLocation = "Browse all locations"; }}><Text style={styles.outlineText}>Browse all</Text></Pressable></View><Text style={styles.tiny}>Nearest sorting unavailable without verified coordinates.</Text></View>
                <Text style={styles.filterLabel}>DIFFICULTY</Text><View style={styles.row}><Pressable style={styles.outlineButton} onPress={lambda { setChoice("difficulty", "Unknown"); }}><Text style={styles.outlineText}>Any</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { setChoice("difficulty", "Easy"); }}><Text style={styles.outlineText}>Easy</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { setChoice("difficulty", "Moderate"); }}><Text style={styles.outlineText}>Moderate</Text></Pressable></View>
                <Text style={styles.filterLabel}>RISK</Text><View style={styles.row}><Pressable style={styles.outlineButton} onPress={lambda { setChoice("risk", "Low"); }}><Text style={styles.outlineText}>Low</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { setChoice("risk", "Moderate"); }}><Text style={styles.outlineText}>Moderate</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { setChoice("risk", "High"); }}><Text style={styles.outlineText}>High</Text></Pressable></View>
                <Text style={styles.filterLabel}>ACCESS</Text><View style={styles.row}><Pressable style={styles.outlineButton} onPress={lambda { setChoice("access", "Public"); }}><Text style={styles.outlineText}>Public</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { setChoice("access", "Permit"); }}><Text style={styles.outlineText}>Permit</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { setChoice("access", "Private"); }}><Text style={styles.outlineText}>Private</Text></Pressable></View>
                <Text style={styles.filterLabel}>CAMPING</Text><View style={styles.row}><Pressable style={styles.outlineButton} onPress={lambda { setChoice("camp", "Public"); }}><Text style={styles.outlineText}>Public</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { setChoice("camp", "Private"); }}><Text style={styles.outlineText}>Private</Text></Pressable></View>
                <Text style={styles.filterLabel}>SORT</Text><View style={styles.row}><Pressable style={styles.outlineButton} onPress={lambda { setChoice("sort", "Nearest"); }}><Text style={styles.outlineText}>Nearest</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { setChoice("sort", "Safest"); }}><Text style={styles.outlineText}>Safest</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { setChoice("sort", "Shortest"); }}><Text style={styles.outlineText}>Shortest</Text></Pressable></View>
                <View style={styles.map}><View style={styles.mapLines}/><View style={styles.mapInner}/><View style={styles.mapPin}><Text style={styles.mapPinText}>⌖</Text></View><Text style={styles.mapLabel}>MAP PREVIEW · COORDINATES NOT VERIFIED</Text></View><Text style={styles.sectionTitle}>{str(len(results))} matching sample destinations</Text>{cards}<View style={styles.notice}><Text style={styles.noticeText}>Unverified sample data. Confirm access, risk, conditions, and camping rules locally.</Text></View></View>;
            }
            elif activeTab == "Saved" { <View style={{"gap": 18}}><Text style={styles.title}>Saved trails</Text>{savedCards}</View>; }
            elif activeTab == "Start Hike" { <View style={{"gap": 18}}><Text style={styles.title}>Plan a safe hike.</Text><View style={styles.card}><Text style={styles.body}>Check current access and weather locally. Tell someone your route and return time. Carry water and suitable footwear.</Text></View><Pressable style={styles.button} onPress={lambda { selectTab("Explore"); }}><Text style={styles.buttonText}>Choose a trail</Text></Pressable></View>; }
            else { <View style={{"gap": 18}}><Text style={styles.title}>Profile</Text><View style={styles.card}><Text style={styles.body}>Hiker preferences and personal details will appear here.</Text></View></View>; }}
        </ScrollView>
        {if detailId == "" { <View style={styles.tabs}>{for (i, tab) in enumerate(tabs) { <Pressable key={tab} style={styles.tab} onPress={lambda { selectTab(tab); }}><Text style={styles.tabIcon}>{icons[i]}</Text><Text style={styles.tabActive if activeTab == tab else styles.tabInactive}>{tab}</Text></Pressable> }}</View> }}
    </View>;
}

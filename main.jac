import from "@jac/mobui" { View, Text, Pressable, TextInput, ScrollView, Image, useWindowDimensions }
import from .theme { LIGHT, buildStyles }

glob styles = buildStyles(LIGHT);
glob destinations: list[dict] = [
    {"id":"ella","name":"Ella Rock","district":"Badulla District","image":"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable","distance":"Not verified","height":"Not verified","coords":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","access":"Legal status unverified","camp":"Camping information unavailable","hazards":"No verified route hazards available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified"},
    {"id":"knuckles","name":"Knuckles Range","district":"Matale District","image":"https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable","distance":"Not verified","height":"Not verified","coords":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","access":"Legal status unverified","camp":"Camping information unavailable","hazards":"No verified route hazards available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified"},
    {"id":"pitu","name":"Pidurutalagala Foothills","district":"Nuwara Eliya District","image":"https://images.unsplash.com/photo-1472396961693-142e6e269027?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable","distance":"Not verified","height":"Not verified","coords":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","access":"Legal status unverified","camp":"Camping information unavailable","hazards":"No verified route hazards available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified"},
    {"id":"hantana","name":"Hantana Ridge","district":"Kandy District","image":"https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1000&q=85","difficulty":"Unknown","risk_key":"Unknown","access_key":"Unverified","camp_key":"Unavailable","distance":"Not verified","height":"Not verified","coords":"Not verified","gain":"Not verified","time":"Not verified","guide":"Unknown","permit":"Not verified","access":"Legal status unverified","camp":"Camping information unavailable","hazards":"No verified route hazards available.","water":"Not verified","parking":"Not verified","facilities":"Not verified","contact":"Not verified","camp_location":"Not verified","camp_price":"Not verified","camp_facilities":"Not verified","camp_contact":"Not verified","camp_restrictions":"Not verified"}
];
glob tabNames: list[str] = ["Home", "Explore", "Start Hike", "Saved", "Profile"];
glob tabIcons: list[str] = ["⌂", "⌕", "↗", "♡", "○"];

def DestinationCard(place: dict, saved: bool, onSave: Callable[[str], None], onOpen: Callable[[str], None]) -> JsxElement {
    return <View style={styles.card}>
        <Pressable onPress={lambda { onOpen(place["id"]); }}><View style={styles.destImageWrap}><Image source={{"uri": place["image"]}} style={styles.destImage} resizeMode="cover"/></View><Text style={styles.destName}>{place["name"]}</Text><Text style={styles.destMeta}>{place["district"]} · Trail distance {place["distance"]}</Text></Pressable>
        <View style={styles.spread}><View style={styles.riskUnknown}><Text style={styles.riskUnknownText}>UNKNOWN RISK · UNVERIFIED</Text></View><Pressable style={styles.outlineButton} onPress={lambda { onSave(place["id"]); }}><Text style={styles.outlineText}>{"Saved" if saved else "Save"}</Text></Pressable></View>
        <View style={styles.chipRow}><View style={styles.chip}><Text style={styles.chipText}>Difficulty: {place["difficulty"]}</Text></View><View style={styles.chip}><Text style={styles.chipText}>{place["access"]}</Text></View></View><Text style={styles.tiny}>{place["camp"]}</Text>
    </View>;
}

def:pub app -> JsxElement {
    has activeTab: str = "Home", query: str = "", savedIds: list[str] = [], detailId: str = "", selectedRisk: str = "All", selectedAccess: str = "All", selectedCamp: str = "All", selectedDifficulty: str = "All", sortMode: str = "Default", startLocation: str = "Browse all locations";
    viewport = useWindowDimensions();
    filtered = [p for p in destinations if (not query or query.lower() in p["name"].lower() or query.lower() in p["district"].lower()) and (selectedRisk == "All" or p["risk_key"] == selectedRisk) and (selectedAccess == "All" or p["access_key"] == selectedAccess) and (selectedCamp == "All" or p["camp_key"] == selectedCamp) and (selectedDifficulty == "All" or p["difficulty"] == selectedDifficulty)];
    savedPlaces = [p for p in destinations if p["id"] in savedIds];
    selectedPlace = {};
    for p in destinations { if p["id"] == detailId { selectedPlace = p; } }
    def toggleSaved(id: str) { if id in savedIds { savedIds = [v for v in savedIds if v != id]; } else { savedIds = savedIds + [id]; } }
    def selectTab(tab: str) { activeTab = tab; detailId = ""; query = ""; }
    def toggleRisk(value: str) { selectedRisk = value if selectedRisk != value else "All"; }
    def toggleAccess(value: str) { selectedAccess = value if selectedAccess != value else "All"; }
    def toggleCamp(value: str) { selectedCamp = value if selectedCamp != value else "All"; }
    def toggleDifficulty(value: str) { selectedDifficulty = value if selectedDifficulty != value else "All"; }
    def setSort(value: str) { sortMode = value; }
    def topHeader() -> JsxElement { return <View style={styles.header}><View style={styles.brandline}><View style={styles.brandMark}><Text style={styles.brandGlyph}>H</Text></View><Text style={styles.brand}>HikeSafe</Text></View><View style={styles.locationIcon}><Text style={styles.locationPin}>⌖</Text></View></View>; }
    def searchBox() -> JsxElement { return <View style={styles.search}><Text style={styles.searchGlyph}>⌕</Text><TextInput style={styles.searchInput} value={query} placeholder="Search mountains and trails" placeholderTextColor={LIGHT["muted"]} onChangeText={lambda (t: str) { query = t; }}/></View>; }
    def sampleNotice() -> JsxElement { return <View style={styles.notice}><Text style={styles.noticeText}>Development samples only. Risk, hazards, route conditions, access, permissions, facilities, and camping details are not verified. Confirm with official local sources before visiting.</Text></View>; }
    def filterChoice(label: str, active: bool, onPress: Callable[[], None]) -> JsxElement { return <Pressable style={[styles.outlineButton, styles.filterActive if active else {}]} onPress={onPress}><Text style={styles.filterActiveText if active else styles.outlineText}>{label}</Text></Pressable>; }

    return <View style={[styles.screen, {"height": viewport.height}]}>
        <ScrollView style={styles.screen} contentContainerStyle={styles.scrollContent} showsVerticalScrollIndicator={False}>
            {if detailId != "" {
                <View style={{"gap": 18}}>
                    <Pressable style={styles.backButton} onPress={lambda { detailId = ""; }}><Text style={styles.outlineText}>‹  Back to trails</Text></Pressable>
                    <View style={styles.detailHero}><Image source={{"uri": selectedPlace["image"]}} style={styles.detailPhoto} resizeMode="cover"/><View style={styles.heroShade}/><View style={styles.detailHeader}><Text style={styles.heroTitle}>{selectedPlace["name"]}</Text><Text style={styles.heroSub}>{selectedPlace["district"]}</Text></View></View>
                    <View style={styles.riskUnknown}><Text style={styles.riskUnknownText}>UNKNOWN RISK · UNVERIFIED</Text></View>
                    <View style={styles.mapDetail}><Text style={styles.mapDetailText}>MAP PLACEHOLDER · Coordinates not verified</Text><Text style={styles.mapDetailText}>{selectedPlace["coords"]}</Text></View>
                    <View style={styles.card}><Text style={styles.sectionTitle}>Overview</Text><Text style={styles.factLabel}>Height above sea level</Text><Text style={styles.factValue}>{selectedPlace["height"]}</Text><Text style={styles.factLabel}>District</Text><Text style={styles.factValue}>{selectedPlace["district"]}</Text></View>
                    <View style={styles.card}><Text style={styles.sectionTitle}>Trail Information</Text><Text style={styles.factLabel}>Trail distance</Text><Text style={styles.factValue}>{selectedPlace["distance"]}</Text><Text style={styles.factLabel}>Elevation gain</Text><Text style={styles.factValue}>{selectedPlace["gain"]}</Text><Text style={styles.factLabel}>Estimated hiking time</Text><Text style={styles.factValue}>{selectedPlace["time"]}</Text><Text style={styles.factLabel}>Difficulty</Text><Text style={styles.factValue}>{selectedPlace["difficulty"]}</Text></View>
                    <View style={styles.card}><Text style={styles.sectionTitle}>Safety</Text><Text style={styles.body}>Risk classification is unverified. No safety rating is assigned.</Text><Text style={styles.factLabel}>Hazard notes</Text><Text style={styles.body}>{selectedPlace["hazards"]}</Text><Text style={styles.factLabel}>Dangerous trail sections</Text><Text style={styles.body}>No verified hazard locations or descriptions are available.</Text></View>
                    <View style={styles.card}><Text style={styles.sectionTitle}>Permissions</Text><Text style={styles.factLabel}>Legal access status</Text><Text style={styles.factValue}>{selectedPlace["access"]}</Text><Text style={styles.factLabel}>Permit requirements</Text><Text style={styles.factValue}>{selectedPlace["permit"]}</Text><Text style={styles.factLabel}>Guide requirement</Text><Text style={styles.factValue}>{selectedPlace["guide"]}</Text><Text style={styles.factLabel}>Official permission contact</Text><Text style={styles.factValue}>{selectedPlace["contact"]}</Text></View>
                    <View style={styles.card}><Text style={styles.sectionTitle}>Camping</Text><Text style={styles.factLabel}>Availability</Text><Text style={styles.factValue}>{selectedPlace["camp"]}</Text><Text style={styles.factLabel}>Location · Price · Facilities</Text><Text style={styles.factValue}>{selectedPlace["camp_location"]} · {selectedPlace["camp_price"]} · {selectedPlace["camp_facilities"]}</Text><Text style={styles.factLabel}>Booking contact · Restrictions</Text><Text style={styles.factValue}>{selectedPlace["camp_contact"]} · {selectedPlace["camp_restrictions"]}</Text></View>
                    <View style={styles.card}><Text style={styles.sectionTitle}>Facilities</Text><Text style={styles.factLabel}>Facilities · Water sources · Parking</Text><Text style={styles.factValue}>{selectedPlace["facilities"]} · {selectedPlace["water"]} · {selectedPlace["parking"]}</Text></View>{sampleNotice()}
                </View>;
            }
            elif activeTab == "Home" {
                <View style={{"gap": 22}}>{topHeader()}<View style={{"gap": 7}}><Text style={styles.eyebrow}>YOUR NEXT OUTDOOR DAY</Text><Text style={styles.title}>Find your trail.</Text><Text style={styles.subtitle}>A little closer to the wild, one step at a time.</Text></View>
                <View style={[styles.card, {"padding": 13}]}><View style={styles.row}><View style={styles.locationIcon}><Text style={styles.locationPin}>⌖</Text></View><View style={{"flex": 1, "gap": 3}}><Text style={styles.tiny}>STARTING LOCATION</Text><Text style={styles.body}>{startLocation}</Text></View><Pressable onPress={lambda { startLocation = "Kandy (manual selection)"; }}><Text style={styles.chipText}>Set Kandy</Text></Pressable></View></View>{searchBox()}
                <Pressable style={styles.hero} onPress={lambda { selectTab("Explore"); }}><Image source={{"uri":"https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1200&q=85"}} style={styles.heroImage} resizeMode="cover"/><View style={styles.heroShade}/><View style={styles.heroContent}><Text style={styles.heroTitle}>Take the scenic route.</Text><Text style={styles.heroSub}>Explore Sri Lanka's highland trails</Text></View></Pressable>
                <Text style={styles.sectionTitle}>Nearby trails · distance unverified</Text>{for p in destinations[:2] { <DestinationCard key={p["id"]} place={p} saved={p["id"] in savedIds} onSave={toggleSaved} onOpen={lambda (id: str) { detailId = id; }}/> }}
                <View style={styles.weather}><Text style={styles.weatherIcon}>☼</Text><View style={styles.weatherInfo}><Text style={styles.weatherTemp}>Weather snapshot</Text><Text style={styles.subtitle}>Local forecast integration coming later</Text></View><Text style={styles.tiny}>PLACEHOLDER</Text></View><Text style={styles.sectionTitle}>Saved for later</Text>
                {if len(savedPlaces) > 0 { for p in savedPlaces { <DestinationCard key={p["id"]} place={p} saved={True} onSave={toggleSaved} onOpen={lambda (id: str) { detailId = id; }}/> } } else { <View style={styles.card}><Text style={styles.subtitle}>Your saved destinations will appear here.</Text><Pressable style={styles.outlineButton} onPress={lambda { selectTab("Explore"); }}><Text style={styles.outlineText}>Explore trails</Text></Pressable></View> }}
                <Pressable style={styles.button} onPress={lambda { selectTab("Start Hike"); }}><Text style={styles.buttonText}>Start planning a hike</Text></Pressable>{sampleNotice()}</View>;
            }
            elif activeTab == "Explore" {
                <View style={{"gap": 16}}>{topHeader()}<View style={{"gap": 7}}><Text style={styles.eyebrow}>DISCOVER SRI LANKA</Text><Text style={styles.title}>Explore trails</Text><Text style={styles.subtitle}>Combine filters to browse samples. No location permission is used.</Text></View>{searchBox()}
                <View style={styles.card}><Text style={styles.filterLabel}>STARTING LOCATION</Text><Text style={styles.body}>{startLocation}</Text><View style={styles.row}><Pressable style={styles.outlineButton} onPress={lambda { startLocation = "Kandy (manual selection)"; }}><Text style={styles.outlineText}>Set Kandy</Text></Pressable><Pressable style={styles.outlineButton} onPress={lambda { startLocation = "Browse all locations"; }}><Text style={styles.outlineText}>Browse all</Text></Pressable></View><Text style={styles.tiny}>Nearest sort is unavailable until verified coordinates and trail distances exist.</Text></View>
                <Text style={styles.filterLabel}>DIFFICULTY</Text><ScrollView horizontal={True} contentContainerStyle={styles.filterScroll}>{filterChoice("Any", selectedDifficulty == "All", lambda { toggleDifficulty("Easy"); })}{filterChoice("Easy", selectedDifficulty == "Easy", lambda { toggleDifficulty("Easy"); })}{filterChoice("Moderate", selectedDifficulty == "Moderate", lambda { toggleDifficulty("Moderate"); })}{filterChoice("Challenging", selectedDifficulty == "Challenging", lambda { toggleDifficulty("Challenging"); })}</ScrollView>
                <Text style={styles.filterLabel}>RISK</Text><ScrollView horizontal={True} contentContainerStyle={styles.filterScroll}>{filterChoice("Any", selectedRisk == "All", lambda { toggleRisk("Low"); })}{filterChoice("Low", selectedRisk == "Low", lambda { toggleRisk("Low"); })}{filterChoice("Moderate", selectedRisk == "Moderate", lambda { toggleRisk("Moderate"); })}{filterChoice("High", selectedRisk == "High", lambda { toggleRisk("High"); })}</ScrollView>
                <Text style={styles.filterLabel}>LEGAL ACCESS</Text><ScrollView horizontal={True} contentContainerStyle={styles.filterScroll}>{filterChoice("Any", selectedAccess == "All", lambda { toggleAccess("Public"); })}{filterChoice("Public", selectedAccess == "Public", lambda { toggleAccess("Public"); })}{filterChoice("Permit", selectedAccess == "Permit", lambda { toggleAccess("Permit"); })}{filterChoice("Private", selectedAccess == "Private", lambda { toggleAccess("Private"); })}</ScrollView>
                <Text style={styles.filterLabel}>CAMPING</Text><ScrollView horizontal={True} contentContainerStyle={styles.filterScroll}>{filterChoice("Any", selectedCamp == "All", lambda { toggleCamp("Public"); })}{filterChoice("Public", selectedCamp == "Public", lambda { toggleCamp("Public"); })}{filterChoice("Private", selectedCamp == "Private", lambda { toggleCamp("Private"); })}</ScrollView>
                <Text style={styles.filterLabel}>SORT</Text><ScrollView horizontal={True} contentContainerStyle={styles.filterScroll}>{filterChoice("Default", sortMode == "Default", lambda { setSort("Default"); })}{filterChoice("Nearest", sortMode == "Nearest", lambda { setSort("Nearest"); })}{filterChoice("Safest", sortMode == "Safest", lambda { setSort("Safest"); })}{filterChoice("Shortest", sortMode == "Shortest", lambda { setSort("Shortest"); })}{filterChoice("Highest", sortMode == "Highest", lambda { setSort("Highest"); })}</ScrollView>
                <View style={styles.map}><View style={styles.mapLines}/><View style={styles.mapInner}/><View style={styles.mapPin}><Text style={styles.mapPinText}>⌖</Text></View><Text style={styles.mapLabel}>MAP PREVIEW · COORDINATES NOT VERIFIED</Text></View><Text style={styles.sectionTitle}>{str(len(filtered))} matching destinations</Text>
                {if len(filtered) == 0 {
                    <View style={styles.emptyState}><Text style={styles.sectionTitle}>No matching trails</Text><Text style={styles.subtitle}>Sample data has no verified values for this filter.</Text></View>
                } else {
                    for p in filtered { <DestinationCard key={p["id"]} place={p} saved={p["id"] in savedIds} onSave={toggleSaved} onOpen={lambda (id: str) { detailId = id; }}/> }
                }}
                {sampleNotice()}
            </View>;
            }
            elif activeTab == "Start Hike" { <View style={{"gap": 20}}>{topHeader()}<Text style={styles.title}>Plan a safe hike.</Text><View style={styles.card}><Text style={styles.sectionTitle}>Before you go</Text><Text style={styles.body}>Check current access and weather locally.</Text><Text style={styles.body}>Tell someone your route and expected return.</Text><Text style={styles.body}>Carry water, suitable footwear, and a charged phone.</Text></View><Pressable style={styles.button} onPress={lambda { selectTab("Explore"); }}><Text style={styles.buttonText}>Choose a trail</Text></Pressable>{sampleNotice()}</View>; }
            elif activeTab == "Saved" { <View style={{"gap": 20}}>{topHeader()}<Text style={styles.title}>Saved trails</Text>{if len(savedPlaces) == 0 { <View style={styles.card}><Text style={styles.subtitle}>Save a destination from Explore to find it here.</Text></View> } else { for p in savedPlaces { <DestinationCard key={p["id"]} place={p} saved={True} onSave={toggleSaved} onOpen={lambda (id: str) { detailId = id; }}/> }}{sampleNotice()}</View>; }
            else { <View style={{"gap": 20}}>{topHeader()}<Text style={styles.title}>Profile</Text><View style={styles.card}><Text style={styles.sectionTitle}>Hiker profile</Text><Text style={styles.subtitle}>Personal details and preferences will live here.</Text></View>{sampleNotice()}</View>; }}
        </ScrollView>
        {if detailId == "" { <View style={styles.tabs}>{for (i, tab) in enumerate(tabNames) { <Pressable key={tab} style={styles.tab} onPress={lambda { selectTab(tab); }}><Text style={styles.tabIcon}>{tabIcons[i]}</Text><Text style={styles.tabActive if activeTab == tab else styles.tabInactive}>{tab}</Text></Pressable> }}</View> }}
    </View>;
}
